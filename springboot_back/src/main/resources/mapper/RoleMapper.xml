<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.book.mapper.RoleMapper">

    <select id="findByCode" resultType="com.example.book.entity.Role">
        SELECT id, code, name, description, create_time
        FROM `role`
        WHERE code = #{code}
    </select>

</mapper>
