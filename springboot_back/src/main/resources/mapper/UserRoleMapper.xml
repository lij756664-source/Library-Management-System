<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.book.mapper.UserRoleMapper">

    <insert id="insert" parameterType="com.example.book.entity.UserRole">
        INSERT INTO user_role (user_id, role_id)
        VALUES (#{userId}, #{roleId})
    </insert>

    <select id="findRolesByUserId" resultType="com.example.book.entity.Role">
        SELECT r.id, r.code, r.name, r.description, r.create_time
        FROM user_role ur
        INNER JOIN `role` r ON ur.role_id = r.id
        WHERE ur.user_id = #{userId}
    </select>

</mapper>
